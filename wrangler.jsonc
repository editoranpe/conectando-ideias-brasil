{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conectando-ideias-brasil",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
